{
  "name": "@natlibfi/melinda-rest-api-commons",
  "description": "Shared modules for microservices of Melinda rest api import system",
  "author": {
    "name": "The National Library of Finland"
  },
  "keywords": [],
  "homepage": "https://www.npmjs.com/package/@natlibfi/melinda-rest-api-commons",
  "bugs": {
    "url": "https://github.com/natlibfi/melinda-rest-api-commons/issues"
  },
  "repository": {
    "url": "https://github.com/NatLibFi/melinda-rest-api-commons"
  },
  "license": "MIT",
  "version": "6.2.0-alpha.0",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "lint": "eslint ./src ./test",
    "lint:dev": "eslint --fix ./src ./test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run lint && npm run typecheck && npm run test:base",
    "test:base": "node --test --test-force-exit --experimental-test-coverage --test-coverage-lines=88 --test-coverage-branches=88 --test-coverage-functions=90 --test-coverage-include=src/** --test-reporter=spec 'test/**/*.test.ts'",
    "test:local": "cross-env NODE_ENV=test node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './test/amqp.*.localtest.ts'",
    "test:healthcheck": "cross-env NODE_ENV=test node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './test/amqp.healthtest.ts'",
    "watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './test/**/*.test.ts'",
    "dev": "npm run watch:test",
    "dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
  },
  "dependencies": {
    "@natlibfi/marc-record": "^11.0.3",
    "@natlibfi/marc-record-serializers": "^11.0.4",
    "@natlibfi/marc-record-validate": "^9.0.2",
    "@natlibfi/marc-record-validators-melinda": "^13.0.6",
    "@natlibfi/melinda-commons": "^16.0.0",
    "amqplib": "^2.2.0",
    "debug": "^4.4.3",
    "http-status": "^2.1.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@natlibfi/fixugen": "^4.0.0",
    "@natlibfi/fixura": "^5.0.0",
    "@natlibfi/fixura-mongo": "^4.0.2",
    "@types/debug": "^4.1.13",
    "@types/http-status": "^0.2.30",
    "@types/node": "^25.9.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
